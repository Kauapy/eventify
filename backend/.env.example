# Configurações do MongoDB
MONGO_URL=mongodb+srv://<usuario>:<senha>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority

# Chave JWT (gere algo forte, ex: openssl rand -base64 48)
JWT_SECRET=troque-por-uma-chave-forte-e-aleatoria

# Credenciais do administrador inicial
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=SuaSenhaForte123@
